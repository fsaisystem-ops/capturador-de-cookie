{
  "manifest_version": 3,
  "name": "Capturador de Cookie",
  "version": "1.9.0",
  "description": "Captura o Cookie completo do Network (página logada) + storage e envia ao webhook.",
  "permissions": ["cookies", "storage", "tabs", "webRequest", "scripting"],
  "host_permissions": ["https://www.example.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/action16.png",
    "32": "icons/action32.png",
    "48": "icons/action48.png",
    "128": "icons/action128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Capturador de Cookie",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/action16.png",
      "32": "icons/action32.png",
      "48": "icons/action48.png",
      "128": "icons/action128.png"
    }
  }
}
