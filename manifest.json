{
  "manifest_version": 3,
  "name": "Capturador de Cookie",
  "version": "1.4.0",
  "description": "Captura o Cookie de uma URL configurável (domínio principal ou subdomínio) e envia para um webhook.",
  "permissions": ["cookies", "storage", "tabs", "webRequest"],
  "host_permissions": ["https://www.example.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Capturador de Cookie — abra Opções"
  }
}
